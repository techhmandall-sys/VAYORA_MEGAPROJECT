# VAYORA online. Copy this to .env on the server and fill in the first block; see "Putting VAYORA
# online" in docs/DEPLOYMENT.md. .env is ignored by git: never commit one.

# ---- Required: it will not start without these ------------------------------------------------

# The address people will use. Its DNS must already point at this server.
VAYORA_DOMAIN=

# Make each with: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=

# The first administrator, created when core-api starts. Password of 12 characters or more.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional: each stays simulated until it is set, and says so -------------------------------

# "Sign in with Google": a Web application OAuth client ID, with https://<your address> as an
# authorised JavaScript origin.
GOOGLE_CLIENT_ID=

# Texts and masked calls: all three or none. Indian numbers need DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
